generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────────────────────
// Better-Auth managed tables (do not rename columns here)
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform roles — 3-tier flat model
// ─────────────────────────────────────────────────────────────────────────────

enum GlobalRole {
  SUPERADMIN // full platform access, can do everything
  ADMIN // platform management, moderation, no superadmin ops
  USER // default — creates orgs, joins as student/teacher
}

// Per-org role — stored as string for flexibility
// Values: ORG_OWNER | TEACHER | STUDENT

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  emailVerified   Boolean    @default(false)
  image           String?
  username        String     @unique
  displayUsername String?
  role            GlobalRole @default(USER)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions Session[]
  accounts Account[]

  orgMemberships OrgMember[]
  ownedOrgs      Organization[] @relation("OrgOwner")
  courseAuthors  Course[]       @relation("CourseAuthor")
  lessonAuthors  Lesson[]       @relation("LessonAuthor")
  enrollments    Enrollment[]
  pageAuthors    Page[]         @relation("PageAuthor")
  comments       Comment[]
  badges         UserBadge[]
  kanbanCards    KanbanCard[]   @relation("CardAssignee")
  auditLogs      AuditLog[]

  @@map("user")
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization
// ─────────────────────────────────────────────────────────────────────────────

enum OrgVisibility {
  PUBLIC // anyone can find and join
  INVITE // join only via invite link/token
  PRIVATE // closed; owner adds members manually
}

model Organization {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  logoUrl     String?
  visibility  OrgVisibility @default(PUBLIC)
  joinToken   String?       @unique
  // GitHub repo provisioned for this org (set after GitHub repo creation)
  githubRepo  String?
  ownerId     String
  owner       User          @relation("OrgOwner", fields: [ownerId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members OrgMember[]
  courses Course[]

  @@map("organization")
}

model OrgMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  // "ORG_OWNER" | "TEACHER" | "STUDENT"
  role           String   @default("STUDENT")
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("org_member")
}

// ─────────────────────────────────────────────────────────────────────────────
// Course — the main learning unit, lives inside an org
// ─────────────────────────────────────────────────────────────────────────────

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Course {
  id             String       @id @default(cuid())
  organizationId String
  authorId       String
  title          String
  slug           String
  description    String?
  coverUrl       String?
  status         CourseStatus @default(DRAFT)
  // Visibility: null = all org members; otherwise comma-sep role list
  visibleToRoles String?
  // AI-generated flag (Polar paid plan)
  aiGenerated    Boolean      @default(false)
  // GitHub dir path inside the org repo, e.g. "courses/intro-to-rust"
  repoDir        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User          @relation("CourseAuthor", fields: [authorId], references: [id])
  lessons      Lesson[]
  enrollments  Enrollment[]
  pages        Page[]
  kanbanBoards KanbanBoard[]

  @@unique([organizationId, slug])
  @@map("course")
}

// ─────────────────────────────────────────────────────────────────────────────
// Lesson — a single lesson inside a course
// ─────────────────────────────────────────────────────────────────────────────

enum LessonType {
  TEXT // rich-text / notion-style
  VIDEO
  QUIZ
  WHITEBOARD
  GIST // embedded code gist
  VISUALIZER
}

model Lesson {
  id        String     @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  position  Int
  type      LessonType @default(TEXT)
  // JSON blob for the lesson body (Tiptap/ProseMirror doc for TEXT, config for others)
  content   String     @default("{}")
  published Boolean    @default(false)
  // GitHub file path, e.g. "courses/intro-to-rust/01-hello-world.md"
  repoPath  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author       User             @relation("LessonAuthor", fields: [authorId], references: [id])
  completions  LessonComplete[]
  quizAttempts QuizAttempt[]

  @@unique([courseId, position])
  @@map("lesson")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enrollment + progress
// ─────────────────────────────────────────────────────────────────────────────

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  completions LessonComplete[]

  @@unique([userId, courseId])
  @@map("enrollment")
}

model LessonComplete {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@map("lesson_complete")
}

// ─────────────────────────────────────────────────────────────────────────────
// Quiz
// ─────────────────────────────────────────────────────────────────────────────

model QuizAttempt {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  score     Int
  maxScore  Int
  answers   String // JSON
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("quiz_attempt")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notion-style Pages (standalone, shareable)
// ─────────────────────────────────────────────────────────────────────────────

enum PageAccess {
  PRIVATE // only author
  ORG // all org members
  VIEW // link-shared: view only
  COMMENT // link-shared: can comment
  EDIT // link-shared: can edit
}

model Page {
  id             String     @id @default(cuid())
  courseId       String?
  organizationId String?
  authorId       String
  title          String
  content        String     @default("{}") // ProseMirror JSON
  access         PageAccess @default(PRIVATE)
  shareToken     String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  course   Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  author   User      @relation("PageAuthor", fields: [authorId], references: [id])
  comments Comment[]

  @@map("page")
}

model Comment {
  id        String   @id @default(cuid())
  pageId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comment")
}

// ─────────────────────────────────────────────────────────────────────────────
// Kanban board
// ─────────────────────────────────────────────────────────────────────────────

model KanbanBoard {
  id       String @id @default(cuid())
  courseId String
  title    String

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  columns KanbanColumn[]

  @@map("kanban_board")
}

model KanbanColumn {
  id       String @id @default(cuid())
  boardId  String
  title    String
  position Int

  board KanbanBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards KanbanCard[]

  @@map("kanban_column")
}

model KanbanCard {
  id         String    @id @default(cuid())
  columnId   String
  title      String
  body       String?
  position   Int
  assigneeId String?
  dueDate    DateTime?

  column   KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?        @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("kanban_card")
}

// ─────────────────────────────────────────────────────────────────────────────
// Gamification — Badges
// ─────────────────────────────────────────────────────────────────────────────

enum BadgeTrigger {
  COURSE_COMPLETE // finished a course
  LESSON_STREAK // N lessons in a row
  FIRST_ENROLLMENT // first course joined
  QUIZ_PERFECT // 100% on a quiz
  TEACHER_CREATED // teacher published first course
  ORG_CREATED // user created an org
}

model Badge {
  id          String       @id @default(cuid())
  name        String       @unique
  description String
  icon        String // emoji or URL
  trigger     BadgeTrigger
  threshold   Int          @default(1) // e.g. streak = 7 lessons

  awards UserBadge[]

  @@map("badge")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badge")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String
  meta      String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_log")
}
