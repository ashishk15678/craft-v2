generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Better auth fields

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ROLE {
  ORG_MANAGER
  SUPERADMIN
  ADMIN
  EDITOR
  TEACHER
  STUDENT
}

// Granular per-org roles (stored as string in OrganizationMember.orgRole)
// ORG_OWNER   – person who created the org; can do everything inside it
// ORG_ADMIN   – can invite, remove, and change roles of INSTRUCTOR/LEARNER
// INSTRUCTOR  – can create team tracks and review learner submissions
// LEARNER     – read-only access to org tracks

model User {
  id                      String               @unique @default(cuid())
  name                    String
  email                   String
  emailVerified           Boolean              @default(false)
  image                   String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  sessions                Session[]
  accounts                Account[]
  role                    ROLE                 @default(STUDENT)
  username                String
  displayUsername         String
  courses                 Courses[]
  studentProgress         StudentProgress?
  authoredChallenges      Challenge[]          @relation("ChallengeAuthor")
  enrollments             Enrollment[]
  submissions             Submission[]
  organizationMemberships OrganizationMember[]
  auditLogs               AuditLog[]           @relation("AuditActor")

  members     Member[]
  invitations Invitation[]
  topics      Topic[]      @relation("TopicCreator")

  @@unique([email])
  @@unique([username])
  @@map("user")
}

enum ChallengeStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ChallengeAccess {
  OPEN
  PAID
  PRIVATE
}

enum ReviewStatus {
  REQUESTED
  ASSIGNED
  APPROVED
  CHANGES_REQUESTED
}

model Challenge {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  summary        String
  track          String
  status         ChallengeStatus  @default(DRAFT)
  access         ChallengeAccess  @default(OPEN)
  priceCents     Int              @default(0)
  languages      String           @default("TypeScript,Python,Go,Rust,C++,Java")
  dockerImage    String?
  starterRepo    String?
  creatorId      String
  creator        User             @relation("ChallengeAuthor", fields: [creatorId], references: [id])
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  stages         ChallengeStage[]
  enrollments    Enrollment[]
  teamTracks     TeamTrack[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ChallengeStage {
  id          String       @id @default(cuid())
  challengeId String
  challenge   Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  brief       String
  hint        String
  testCommand String
  submissions Submission[]

  @@unique([challengeId, position])
}

model Enrollment {
  id           String       @id @default(cuid())
  userId       String
  challengeId  String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge    Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  language     String       @default("TypeScript")
  currentStage Int          @default(1)
  completedAt  DateTime?
  benchmarks   Benchmark[]
  peerReviews  PeerReview[] @relation("ReviewAuthor")

  @@unique([userId, challengeId])
}

model Submission {
  id         String         @id @default(cuid())
  userId     String
  stageId    String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage      ChallengeStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  commitSha  String
  testOutput String
  passed     Boolean        @default(false)
  createdAt  DateTime       @default(now())
}

model Benchmark {
  id                String     @id @default(cuid())
  enrollmentId      String
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  requestsPerSecond Float
  p99LatencyMs      Float
  memoryMb          Float
  verifiedAt        DateTime   @default(now())
}

model PeerReview {
  id           String       @id @default(cuid())
  enrollmentId String
  reviewerId   String?
  status       ReviewStatus @default(REQUESTED)
  notes        String?
  enrollment   Enrollment   @relation("ReviewAuthor", fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  ownerId     String?
  members     Member[]
  orgMembers  OrganizationMember[]
  challenges  Challenge[]
  teamTracks  TeamTrack[]
  createdAt   DateTime             @default(now())
  logo        String?
  metadata    String?
  invitations Invitation[]
  topics      Topic[]

  @@map("organization")
}

model TeamTrack {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  challengeId    String?
  challenge      Challenge?   @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  title          String
  description    String
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([challengeId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Per-org granular role: ORG_OWNER | ORG_ADMIN | INSTRUCTOR | LEARNER
  role           String       @default("LEARNER")
  joinedAt       DateTime     @default(now())

  @@unique([organizationId, userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String
  metadata  String?
  createdAt DateTime @default(now())
}

model StudentProgress {
  id                  String   @id @default(cuid())
  userId              String   @unique
  activeChallenge     String   @default("Build Your Own KV Store")
  language            String   @default("TypeScript")
  currentStage        Int      @default(4)
  totalStages         Int      @default(6)
  hintsUsed           Int      @default(1)
  peerReviewRequested Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_progress")
}

model Courses {
  id          String    @unique @default(cuid())
  name        String
  description String
  lessons     Lessons[]
  creatorId   String
  creator     User      @relation(fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lessons {
  id       String  @unique @default(cuid())
  name     String
  courseId String
  course   Courses @relation(fields: [courseId], references: [id])
  content  String

}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ─── AI-generated topics ──────────────────────────────────────────────────────
// Free users get MAX_FREE_TOPICS (3) AI-generated topics total, across all orgs.
// The UI enforces this by counting prisma.topic where aiGenerated=true and creatorId=userId.
// Content is a structured JSON string with sections, conceptMap, notes, visualizations, quiz.

model Topic {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creatorId      String
  creator        User         @relation("TopicCreator", fields: [creatorId], references: [id])

  title       String
  subject     String   // raw topic the user typed, e.g. "React Server Components"
  aiGenerated Boolean  @default(false)
  // Full structured content blob (JSON string)
  content     String   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([creatorId])
  @@map("topic")
}
